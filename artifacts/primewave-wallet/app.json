{
  "expo": {
    "name": "WaveX",
    "slug": "wavex",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wavex",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.wavex.app"
    },
    "android": {
      "package": "com.wavex.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "backgroundColor": "#090B0E"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock your WaveX wallet."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#090B0E",
          "image": "./assets/images/mark.png",
          "imageWidth": 152,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "87e5e2c2-52d6-4d5f-87f3-5e73f3c251a1"
      }
    },
    "owner": "hritik1995"
  }
}
